# Send only image inputs; source provenance is checked on the complete checkout
# or extracted archive before Docker receives this deliberately partial context.
**
!Dockerfile
!Dockerfile.ncm
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!LICENSE
!THIRD_PARTY_NOTICES.md
!favicon.png
!favicon.svg
!functions/
!functions/**
!server/
!server/**
!player/
!player/package.json
!player/pnpm-lock.yaml
!player/pnpm-workspace.yaml
!player/.npmrc
!player/index.html
!player/vite.config.ts
!player/tsconfig.json
!player/postcss.config.mjs
!player/src/
!player/src/**
!player/build/
!player/build/**
!player/public/
!player/public/**
!scripts/
!scripts/write-release-manifest.mjs
!scripts/release-inputs.mjs
!scripts/backup-recommend-db.mjs
!scripts/restore-recommend-db.mjs
!scripts/verify-observability-and-alerts.mjs

# Never re-include secrets, dependency caches or generated output via source dirs.
**/.env
**/.env.*
**/node_modules
**/dist
**/dist-server
**/.git
**/.wrangler
**/.deploy
**/.zcode
**/.cache
**/.vite
**/.pnpm-store
**/__pycache__
**/data
**/reports
**/cache
**/backups
**/rollback-data
**/coverage
**/e2e-results
**/e2e-report
**/test-results
**/credentials*
**/secrets*
**/cookies*
**/storage-state*
**/storageState*
**/auth-state*
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.log
**/*.sqlite*
**/*.db*
**/*.zip
**/*.tar
**/*.gz
**/*.webm
**/*.pyc
**/*.tsbuildinfo
player/src/auto-import/eslintrc-auto-import.json
**/*.bak
**/*.tmp
**/*~
**/.DS_Store
