# ==============================================================================
# epocanvas sonic Music Gateway — Environment Variables Template (.env.example)
# Copy to `.env` on Linux VPS (`chmod 600 .env`) — NEVER commit real `.env`!
# ==============================================================================

# 1. Inter-Service Security (REQUIRED on both Cloudflare Pages & Linux VPS)
# Generate with: openssl rand -hex 32
SONIC_ENGINE_SECRET=
# Rotation: move the current secret to _PREV before deploying a new one.
# Both primary and previous are accepted during the rotation window.
# SONIC_ENGINE_SECRET_PREV=
# Independent Edge-to-Engine identity key; never reuse SONIC_SECRET or the service key.
# Production Engine/Edge hops require this key even if the override below is unset.
SONIC_ENGINE_IDENTITY_SECRET=
# Rotation: move the current identity secret to _PREV before deploying a new one.
# SONIC_ENGINE_IDENTITY_SECRET_PREV=
SONIC_REQUIRE_ENGINE_IDENTITY=1
# The engine enforces this key on every API route whenever SONIC_RUNTIME=linux-engine.
# Host / X-Forwarded-Host headers are never used to decide whether auth is required.

# On Cloudflare Pages ONLY (leave empty on Linux VPS to avoid self-loop):
# SONIC_LOCAL_ENGINE_URL=https://engine-sonic.epocanvas.tech

# 2. Runtime & Port Binding (Linux VPS)
SONIC_RUNTIME=linux-engine
SONIC_BIND_PORT=8080
# Placeholder only (RFC 5737 documentation range). Set this to the egress IP
# required by your upstream; never commit a real production IP.
SONIC_REAL_IP=203.0.113.10

# 3. Optional User Cookies (Leave empty for guest/free-catalog mode; mount own account Cookie only if desired)
NETEASE_COOKIE=
QQ_COOKIE=
KUGOU_COOKIE=

# 4. Provider Switches & Content Licensing Policy (SONIC-P0-07)
# Content policy modes:
#   default          -> Local development only. It honours the individual SONIC_ENABLE_*
#                       switches below and MUST NOT be used on a production deployment.
#   strict-allowlist -> Required for staging and production. ONLY comma-separated sources in
#                       SONIC_ALLOWED_SOURCES are enabled; PROHIBITED and PENDING_CONFIRMATION
#                       sources stay blocked even when listed. All unapproved sources return
#                       HTTP 403 SOURCE_DISABLED_BY_POLICY across audio, lyrics, covers & catalog.
# Production startup fails closed unless this is strict-allowlist and SONIC_ALLOWED_SOURCES
# contains only written-off APPROVED/CONDITIONAL sources AND at least one of them is
# runtime-enabled. The project owner directly authorized the commercial/community
# sources below on 2026-11-05; formal documents are tracked in CHECKLIST.log.
SONIC_CONTENT_POLICY=strict-allowlist
SONIC_ALLOWED_SOURCES=netease,qq,kugou,kuwo,amll,lrclib
SONIC_ENABLE_SYNTHETIC_TEST_SOURCE=0
# SONIC_AUTHORIZED_TEST_DOMAINS=
# PROHIBITED sources (gdstudio/lyriva/unblock) are force-disabled by code, but keep these at 0
# so deployment scanners and reviewers see the intended state.
SONIC_ENABLE_NETEASE=1
SONIC_ENABLE_QQ=1
SONIC_ENABLE_KUGOU=1
SONIC_ENABLE_KUWO=1
SONIC_ENABLE_AMLL=1
SONIC_ENABLE_LRCLIB=1
# Canonical name. The pre-2.2 alias SONIC_ENABLE_FREE_MATCH is still read when this is empty,
# and will be retired after the 2.2 release line.
SONIC_ENABLE_FREE_CROSS_MATCH=1
SONIC_ENABLE_GDSTUDIO=0
SONIC_ENABLE_LYRIVA=0
SONIC_ENABLE_UNBLOCK=0
# Optional Apple Music / YouTube Music providers (require credentials; disabled by default)
SONIC_ENABLE_APPLE=0
SONIC_APPLE_MUSIC_TOKEN=
SONIC_ENABLE_YTMUSIC=0
SONIC_YOUTUBE_API_KEY=
# Optional custom upstreams MUST be HTTPS public endpoints; private/loopback targets are rejected.
# SONIC_UPSTREAM_AMLL=https://api.amll.dev
# SONIC_UPSTREAM_LRCLIB=https://lrclib.net
# SONIC_UPSTREAM_GDSTUDIO=
# SONIC_UPSTREAM_LYRIVA=

# 5. Timeouts, Circuit Breaker & Rate Limiting
SONIC_TIMEOUT_MS=8000
SONIC_ENGINE_TIMEOUT_MS=4500
SONIC_CB_FAILURE_THRESHOLD=3
SONIC_CB_COOLDOWN_MS=30000
SONIC_RATE_LIMIT_ANON_RPM=240
SONIC_RATE_LIMIT_AUTH_RPM=600
SONIC_REQUIRE_AUTH=0
# Cloudflare Pages production MUST bind RATE_LIMITER. With this set to 1, a missing
# binding fails closed (503) instead of silently using per-isolate memory limits.
# Local development without the binding should set SONIC_ENV=test/staging and 0.
SONIC_REQUIRE_DISTRIBUTED_RATE_LIMIT=1
SONIC_RATE_LIMIT_FAIL_CLOSED=1
# Cloudflare Pages binding recommendations (not env vars):
#   RATE_LIMITER  -> native Rate Limiting binding (atomic, shared across isolates; preferred)
#   RATE_LIMIT_KV -> KV namespace fallback (best-effort, not atomic; rate headers are advisory)
# With neither binding, each isolate falls back to a bounded in-memory limiter.

# 6. Epomail OAuth 2.0 & API Key Signing (REQUIRED for Auth & API Keys)
# Generate SONIC_SECRET with: openssl rand -base64 48 (MUST be at least 32 characters)
SONIC_SECRET=
# Token format: sonic_live_v2.<header>.<payload>.<signature> (sub/iat/exp/jti/kid).
# v1 and unsigned keys are rejected; existing users must re-login after this upgrade.
# Optional stable key labels (kid). When omitted, kid is derived from the secret.
# SONIC_SECRET_KID=prod-2026-01
# Rotation: move the old secret to SONIC_SECRET_PREV (and its label to _PREV_KID).
# SONIC_SECRET_PREV=
# SONIC_SECRET_PREV_KID=prod-2025-12
# Revocation (comma-separated): individual jti values, subjects (emails), or a global
# issuance floor. Changes require a Cloudflare/VPS deploy to take effect.
# SONIC_REVOKED_JTIS=
# SONIC_REVOKED_SUBS=
# SONIC_TOKEN_MIN_IAT=0
# API keys are accepted only from request headers; ?api_key= is never supported.
# Browser OAuth sessions are delivered as an HttpOnly, Secure, SameSite=Lax cookie
# (`sonic_session`); the API key is never placed in the redirect URL.
#
# Optional immediate revocation via Cloudflare KV:
# 1. Create a KV namespace and bind it in Pages as SONIC_KEY_REVOCATION_KV.
# 2. Revocation is enabled by default when that binding exists; set
#    SONIC_ENABLE_KEY_REVOCATION=0 only to explicitly accept non-revocable keys.
# 3. POST /api/auth/revoke with X-Sonic-Key; POST /api/auth/key rotation and logout
#    will also revoke the current jti when this store is enabled.
# The other-isolate propagation window is 30 seconds. If KV reads fail while enabled,
# authentication fails closed by default; set SONIC_KEY_REVOCATION_FAIL_CLOSED=0 to
# prefer availability over revocation enforcement.
SONIC_ENABLE_KEY_REVOCATION=1
# SONIC_KEY_REVOCATION_FAIL_CLOSED=1

# Epomail OAuth 2.0 Credentials (REQUIRED for OAuth login; missing returns 503)
# Set SONIC_ENABLE_OAUTH=0 in Controlled Beta if OAuth login entrypoints should be gated off
# while keeping API-key / session verification active on protected server endpoints.
SONIC_ENABLE_OAUTH=1
# EPOMAIL_BASE_URL must be HTTPS (plain HTTP is accepted only for localhost development).
EPOMAIL_BASE_URL=https://mail.epocanvas.com
EPOMAIL_CLIENT_ID=
EPOMAIL_CLIENT_SECRET=
# Token exchange body format: 'json' (default) or 'form' (RFC 6749 application/x-www-form-urlencoded)
EPOMAIL_TOKEN_CONTENT_TYPE=json
# Fixed redirect URI (recommended) or allowed origins whitelist
# EPOMAIL_REDIRECT_URI=https://sonic.epocanvas.tech/api/auth/callback
# Token exchange / userinfo timeout (milliseconds)
EPOMAIL_HTTP_TIMEOUT_MS=8000
SONIC_ALLOWED_ORIGINS=https://sonic.epocanvas.tech,https://sonic.epocanvas.com

# 7. Intelligent Recommendation & Smart Search Engine (Stage 1 Native SQLite + Optional Stage 2/3 Adapters)
# Built-in Node 22 SQLite (WAL + FTS5) path on Linux VPS; set to `memory` to disable disk persistence
SONIC_RECOMMEND_DB_PATH=/app/data/sonic-recommend.sqlite
SONIC_ACCOUNT_DB_PATH=/app/data/sonic-account.sqlite
SONIC_RECOMMEND_RETENTION_DAYS=90

# Optional ListenBrainz public artist similarity enrichment (strictly rate-limited <= 1 req/s, 6h cache; 0=off by default)
SONIC_ENABLE_LISTENBRAINZ=0

# Optional Stage 2 External Gorse Collaborative Filtering Service (leave empty for lightweight single-VPS mode)
SONIC_GORSE_URL=
SONIC_GORSE_API_KEY=

# Optional Stage 3 External Meilisearch Engine (leave empty to use built-in SQLite FTS5 + Pinyin/Alias index)
SONIC_MEILISEARCH_URL=
SONIC_MEILISEARCH_KEY=
SONIC_MEILISEARCH_INDEX=sonic_tracks

# 8. Controlled public beta access (independent from EpoMail OAuth)
# open=public, legacy-staging=shared legacy token, invite=individual invite codes
SONIC_ACCESS_MODE=open
# Pages invite mode requires an independent HMAC secret (>=32 chars); never reuse SONIC_SECRET or ENGINE secrets.
# SONIC_ACCESS_SECRET=
# Dedicated persistent DB for invite hashes and opaque access sessions; never reuse recommendation/account DB.
# SONIC_ACCESS_DB_PATH=/app/data/sonic-access.sqlite
# Seed only during a controlled deployment; values are hashed on insert and never returned.
# Every invite code MUST be at least 16 characters. Pages-only invite mode signs a
# reusable session and cannot revoke it server-side; use SONIC_ACCESS_DB_PATH on the
# Engine when single-use redemption or revocation is required.
# SONIC_INVITE_CODES=
SONIC_ACCESS_SESSION_MAX_AGE_SEC=604800

# 9. Release Traceability, Isolated Staging Access Gate & Alerting (SONIC-P1-03 / P1-04)
SONIC_ENV=production
SONIC_RELEASE_COMMIT=unknown
# Optional (>= 16 chars) Staging access token: blocks anonymous public access and adds X-Robots-Tag: noindex
SONIC_STAGING_ACCESS_TOKEN=
# Minimum free disk space (MB) on SQLite volume before /api/sonic/engine/health fails closed with 503
SONIC_MIN_FREE_DISK_MB=64
# Optional HTTPS Webhook URL (Slack / Discord / Feishu / Generic JSON) for 5xx spikes & storage failures
SONIC_ALERT_WEBHOOK_URL=
SONIC_ALERT_COOLDOWN_SEC=300
SONIC_ALERT_5XX_THRESHOLD=5
SONIC_ALERT_WINDOW_SEC=300
SONIC_ALERT_MIN_REQUESTS=100
SONIC_ALERT_5XX_WARNING_RATIO=0.02
SONIC_ALERT_5XX_PAGING_RATIO=0.05
# P95 alarms require explicit route-appropriate thresholds; 0 disables each alarm.
SONIC_ALERT_P95_WARNING_MS=0
SONIC_ALERT_P95_PAGING_MS=0

# Release metadata is generated by scripts/write-release-manifest.mjs and must match the image.
# SONIC_BUILD_TIME=2026-11-02T00:00:00.000Z
# SONIC_RELEASE_ID=<release.json releaseId; dirty trees use base SHA plus source digest>
# SONIC_SOURCE_DIGEST=<release.json sourceDigest; 64 hex characters>
# SONIC_RELEASE_DIRTY=true
# Production requires a valid base commit/build time; unknown is only for development.
# SONIC_SHUTDOWN_TIMEOUT_MS=60000 (Compose pins 60000; stop_grace_period is 75s.)
# Offline restore: stop every writer/restart supervisor, then pass --offline.
# Existing WAL/SHM/journal files or .maintenance-lock refuse restore; never delete them to bypass it.
# Inspect a stale lock owner and recover/checkpoint the database offline before retrying.
# Backups print a SHA-256; retain verified copies on a separate host/storage with an explicit retention policy.
