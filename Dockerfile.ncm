# Internal NetEase Protocol Sidecar (Pinned @neteasecloudmusicapienhanced/api@4.41.1, MIT License)
# Strictly internal to Docker Compose network; VIP unblock (`ENABLE_UNBLOCK`) disabled by default.
# Same Node base digest as the verified 2026-11-02 engine build; no base upgrade.
FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914
WORKDIR /app

COPY ncm-sidecar/package.json ncm-sidecar/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0
ENV ENABLE_UNBLOCK=false

EXPOSE 3000
HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/inner/version >/dev/null || exit 1

USER node
CMD ["./node_modules/.bin/api"]
