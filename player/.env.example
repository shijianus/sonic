# 环境标识
# Optional: development | test | production
VITE_USER_NODE_ENV = development

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = history

# 接口地址
VITE_APP_BASE_API = 'http://localhost:3000'

# Shijianus-Blog 随身听桥接允许的 origin（逗号分隔，必须是 https；本地开发可用 localhost）
# 默认已允许 https://blog.shijianus.com 与同源窗口；其它博客域名需在此显式追加。
# VITE_SONIC_BRIDGE_ORIGINS = https://blog.example.com

# 开发环境跨域代理，支持配置多个
# VITE_PROXY = [["/api","http://127.0.0.1:3000"]]
