    "gsap": "^3.13.0",
    "hls.js": "^1.6.15",
    "lottie-web": "^5.13.0",
    "music-metadata": "^11.16.0",
    "nprogress": "^0.2.0",
    "ogl": "^1.0.11",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "swiper": "^12.0.3",
