    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-qrcode": "^0.3.0",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.1"
