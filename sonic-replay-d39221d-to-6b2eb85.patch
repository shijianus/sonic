diff --git a/player/e2e/specs/playback-listening.spec.ts b/player/e2e/specs/playback-listening.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ab789fed8302c90c14632c2d76dcb95d6eebefee
--- /dev/null
+++ b/player/e2e/specs/playback-listening.spec.ts
@@ -0,0 +1,29 @@
+import { test, expect, expectPlaying } from '../fixtures'
+
+test('真实音频跳到末尾不会上报完播，从头播放才会上报', async ({ page }) => {
+  const events: Array<{ type: string; track?: { id: number | string }; playedSeconds?: number }> = []
+  await page.addInitScript(() => {
+    localStorage.setItem('recommend', JSON.stringify({ personalizationEnabled: true, anonId: 'anon_playback_listening_e2e' }))
+  })
+  await page.route('**/api/sonic/events', async route => {
+    if (route.request().method() !== 'POST') return route.fallback()
+    events.push(...route.request().postDataJSON().events)
+    await route.fulfill({ json: { data: { accepted: 1 } } })
+  })
+
+  await page.goto('/#/search?q=sonic')
+  await page.getByTestId('song-row-9001').click()
+  await expectPlaying(page)
+  await expect.poll(() => events.some(event => event.type === 'play_start' && String(event.track?.id) === '9001')).toBe(true)
+
+  await page.locator('#audioPlayer').evaluate((audio: HTMLAudioElement) => {
+    audio.currentTime = audio.duration - 0.3
+  })
+  await expect(page.getByTestId('now-playing-title')).toHaveText('Test Song Two')
+  await expectPlaying(page)
+  await page.locator('#audioPlayer').evaluate((audio: HTMLAudioElement) => { audio.playbackRate = 4 })
+
+  await expect.poll(() => events.find(event => event.type === 'play_complete' && String(event.track?.id) === '9002'), { timeout: 15_000 })
+    .toMatchObject({ playedSeconds: 20 })
+  expect(events.some(event => event.type === 'play_complete' && String(event.track?.id) === '9001')).toBe(false)
+})
diff --git a/player/e2e/specs/privacy-erasure.spec.ts b/player/e2e/specs/privacy-erasure.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5ffdcc1d5b65a0ab60d091c8c013d387673928b9
--- /dev/null
+++ b/player/e2e/specs/privacy-erasure.spec.ts
@@ -0,0 +1,35 @@
+import { test, expect } from '../fixtures'
+
+test('a failed remote erasure preserves the anonymous profile ID for retry', async ({ page }, testInfo) => {
+  const anonId = 'anon_erasure_browser_001'
+  const deletes: string[] = []
+  await page.addInitScript((id) => {
+    localStorage.setItem('recommend', JSON.stringify({ personalizationEnabled: true, anonId: id }))
+    localStorage.setItem('sonic-e2e-local-data', 'preserved')
+  }, anonId)
+
+  await page.route('**/api/sonic/events', async (route) => {
+    if (route.request().method() !== 'DELETE') return route.continue()
+    deletes.push(route.request().headers()['x-sonic-anon-id'] || '')
+    if (deletes.length === 1) {
+      await route.fulfill({ status: 503, json: { brand: 'Sonic', error: { code: 'EVENT_ERASURE_INCOMPLETE' } } })
+    } else {
+      await route.fulfill({ json: {
+        brand: 'Sonic', data: { cleared: true, storageKind: 'sqlite', removedEvents: 1 },
+      } })
+    }
+  })
+
+  await page.goto('/#/settings')
+  await page.getByRole('button', { name: 'Clear all local data', exact: true }).click()
+  const dialog = page.getByRole('dialog', { name: 'Clear all local data?' })
+  await expect(dialog).toBeVisible()
+  await dialog.screenshot({ path: testInfo.outputPath('privacy-erase-dialog.png') })
+  await dialog.getByRole('button', { name: 'Clear everything' }).click()
+  await expect(page.getByText('Some data could not be cleared. Please retry.')).toBeVisible()
+  expect(await page.evaluate(() => localStorage.getItem('sonic-e2e-local-data'))).toBe('preserved')
+
+  await page.getByRole('button', { name: 'Reset Recommendation Profile & Dislikes' }).click()
+  await expect(page.getByText('Recommendation profile and disliked tracks cleared')).toBeVisible()
+  expect(deletes).toEqual([anonId, anonId])
+})
